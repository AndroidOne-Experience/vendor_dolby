type hal_aidl_dms_default, domain;
type hal_aidl_dms_default_exec, exec_type, vendor_file_type, file_type;
type hal_aidl_dms_service, service_manager_type, hal_service_type;

# Set up the domain
typeattribute hal_aidl_dms_default hal_aidl_dms_server;
init_daemon_domain(hal_aidl_dms_default)
binder_use(hal_aidl_dms_default)

# Shared Dolby data storage
type vendor_dolby_file, file_type, data_file_type;
allow hal_aidl_dms_server vendor_dolby_file:dir create_dir_perms;
allow hal_aidl_dms_server vendor_dolby_file:file create_file_perms;

# AIDL Service Rules
add_service(hal_aidl_dms_server, hal_aidl_dms_service)
allow hal_aidl_dms_client hal_aidl_dms_service:service_manager find;

# Binder IPC logic
binder_call(hal_aidl_dms_client, hal_aidl_dms_server)
binder_call(hal_aidl_dms_server, hal_aidl_dms_client)

# HAL Dependencies
binder_call(hal_aidl_dms_default, hal_audio_default)
get_prop(hal_aidl_dms_default, vendor_audio_prop)