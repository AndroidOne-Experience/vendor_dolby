# HIDL DMS
hal_client_domain(priv_app, hal_dms)
hal_client_domain(priv_app_36, hal_dms)

# AIDL DMS
typeattribute priv_app hal_aidl_dms_client;
typeattribute priv_app_36 hal_aidl_dms_client;

# Motorola settings service
allow priv_app mot_system_service:service_manager find;
allow priv_app_36 mot_system_service:service_manager find;